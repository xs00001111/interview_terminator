{
  "name": "interview_terminator",
  "version": "1.0.8",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:speaker": "electron test-speaker-detection.js",
    "start": "electron .",
    "server": "node server.js",
    "electron": "electron .",
    "dev": "concurrently \"npm run server\" \"npm run electron\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --win",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "dist:win": "electron-builder --win",
    "build:swift-system-audio": "(cd swift-audio-capture && swift build --configuration release --arch arm64 --arch x86_64) && lipo -create -output ./bin/AudioCapture ./swift-audio-capture/.build/arm64-apple-macosx/release/swift-audio-capture ./swift-audio-capture/.build/x86_64-apple-macosx/release/swift-audio-capture",
    "mac:dir:x64": "electron-builder --mac dir --x64 --config.mac.identity=null",
    "mac:dir:arm64": "electron-builder --mac dir --arm64 --config.mac.identity=null",
    "mac:dir:x64:unsigned": "electron-builder --mac dir --x64 --config.mac.identity=null",
    "mac:dir:arm64:unsigned": "electron-builder --mac dir --arm64 --config.mac.identity=null",
    "merge:universal": "node scripts/make-universal.js",
    "sign:website": "electron-osx-sign dist/universal/Interview-Terminator.app --identity='Developer ID Application: Xin Shen (8Q3VHHBNHM)' --hardened-runtime=true --entitlements=build/entitlements.mac.plist --entitlements-inherit=build/entitlements.mac.plist",
    "notarize:website": "xcrun notarytool submit 'dist/universal/Interview-Terminator.app' --keychain-profile AC_NOTARY --wait",
    "pkg:dmg": "electron-builder --mac dmg --prepackaged 'dist/universal/Interview-Terminator.app'",
    "sign:mas": "electron-osx-sign dist/universal/Interview-Terminator.app --identity='Apple Distribution: YOUR COMPANY (TEAMID)' --entitlements=build/entitlements.mas.plist --entitlements-inherit=build/entitlements.mas.inherit.plist",
    "pkg:mas": "electron-builder --mac mas --prepackaged 'dist/universal/Interview-Terminator.app'",
    "ship:website": "npm run mac:dir:x64 && npm run mac:dir:arm64 && npm run merge:universal && npm run sign:website && npm run notarize:website && npm run pkg:dmg",
    "ship:mas": "npm run mac:dir:x64 && npm run mac:dir:arm64 && npm run merge:universal && npm run sign:mas && npm run pkg:mas",
    "diagnose:prod": "open \"dist/universal/Interview-Terminator.app\" --args --enable-logging --v=1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A desktop application for transcribing and analyzing conversations using Google Cloud Speech and AI services",
  "dependencies": {
    "@google-cloud/speech": "^6.7.1",
    "@google/generative-ai": "^0.24.0",
    "@supabase/supabase-js": "^2.54.0",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "electron-log": "^5.3.2",
    "electron-store": "7.0.0",
    "electron-updater": "^6.6.2",
    "google-gax": "^4.4.1",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^4.87.3",
    "jimp": "^0.22.12",
    "update-electron-app": "^3.1.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.xs.firstapp",
    "productName": "Interview-Terminator",
    "protocols": [
      {
        "name": "Interview Terminator Auth",
        "schemes": [
          "myapp"
        ]
      }
    ],
    "asar": false,
    "artifactName": "${productName}-Setup-${arch}.${ext}",
    "icon": "icon_512x512.png",
    "publish": {
      "provider": "github",
      "owner": "xs00001111",
      "repo": "interview_terminator"
    },
    "extraResources": [
      {
        "from": "system_prompt.txt",
        "to": "."
      },
      {
        "from": "bin/AudioCapture",
        "to": "bin/AudioCapture"
      },
      {
        "from": ".env.production",
        "to": "."
      },
      {
        "from": "app-update.yml",
        "to": "."
      }
    ],
    "mac": {
      "notarize": false,
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "icon_512x512.png",
      "signIgnore": [
        "node_modules/electron/dist/Electron.app/Contents/Frameworks/Electron Framework.framework/Versions/A/Resources/*/locale.pak"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "InterviewTerminator",
      "format": "UDZO"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": [],
      "publisherName": null
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "shortcutName": "Interview Terminator",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon_512x512.png",
      "category": "Utility"
    },
    "files": [
      "**/*",
      ".env.production",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!scripts/**/*",
      "!logo.svg",
      "!swift-audio-capture/**/*",
      "!examples/**/*",
      "!*.txt",
      "!test-*.js",
      "!**/TROUBLESHOOTING.md",
      "!**/INTEGRATION.md",
      "!ICON_README.md",
      "!fix_permissions.sh",
      "!swift-audio-performance-report.json",
      "system_prompt.txt"
    ]
  }
}
